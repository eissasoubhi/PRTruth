{
  "name": "prtruth",
  "version": "0.1.0",
  "description": "Evidence-based verification for AI-generated pull requests.",
  "type": "module",
  "bin": {
    "prtruth": "dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "commander": "^15.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  },
  "license": "MIT",
  "keywords": [
    "ai",
    "code-review",
    "github",
    "pull-request",
    "verification",
    "coding-agents"
  ]
}
